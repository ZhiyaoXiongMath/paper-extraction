# Model service used for new batches.
PAPER_EXTRACTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4-mini

# Optional services. Only the selected provider receives requests.
DEEPSEEK_API_KEY=
DEEPSEEK_TEXT_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
ZAI_API_KEY=
ZHIPU_TEXT_MODEL=glm-5.3
ZHIPU_VISION_MODEL=glm-4.6v
PAPER_EXTRACTION_CONCURRENCY=2
PAPER_EXTRACTION_MAX_IMPORT_FILES=1000
